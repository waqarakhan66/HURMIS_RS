              <DbSource ConnectionRef="HURMISConnectionString (MySettings)" DbObjectName="HURMIS.dbo.designations" DbObjectType="Table" FillMethodModifier="Public" FillMethodName="FillByRetired" GenerateMethods="Both" GenerateShortCommands="true" GeneratorGetMethodName="GetDataBy2" GeneratorSourceName="FillByRetired" GetMethodModifier="Public" GetMethodName="GetDataBy2" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetDataBy2" UserSourceName="FillByRetired">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT        ds.wid, ds.gid, ds.did, 
                         d.designation + ' (' + CASE ds.wid WHEN 'F' THEN 'FBS' WHEN 'P' THEN 'PCO' WHEN 'A' THEN 'ACO' END + ' : ' + CASE ds.gid WHEN 'AD' THEN 'Administration' WHEN 'DP' THEN 'Data Processing' WHEN 'DR' THEN
                          'Drawing' WHEN 'FD' THEN 'Field' WHEN 'GE' THEN 'Geography' WHEN 'PE' THEN 'PE&amp;R Cell' WHEN 'RE' THEN 'Reproduction' WHEN 'ST' THEN 'Statistics' WHEN 'TE' THEN 'Technical' WHEN 'TR' THEN 'Training'
                          WHEN 'VG' THEN 'Vigilance' WHEN 'PR' THEN 'Printing' END + ')' AS post, ds.minBS, ds.maxBS, COUNT(e.nic) AS sv, COUNT(e.name) AS s, COUNT(e.nic) - COUNT(e.name) AS v, ds.ss
FROM            designations AS ds INNER JOIN
                         designation AS d ON ds.did = d.did INNER JOIN
                         employee AS e ON ds.wid = e.wid AND ds.gid = e.gid AND ds.did = e.did
WHERE        (e.srv IN ('S', 'V')) AND ((ds.wid + ds.gid + ds.did) IN
                             (SELECT DISTINCT wid + gid + did AS Expr1
                               FROM            employee
                               WHERE        (srv = 'R')))
GROUP BY ds.wid, ds.gid, ds.did, d.designation, ds.minBS, ds.maxBS, ds.ss
ORDER BY ds.did, CASE ds.wid WHEN 'F' THEN 1 WHEN 'P' THEN 2 WHEN 'A' THEN 3 END, ds.gid</CommandText>
